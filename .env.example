# Sudarshan Platform Environment Configuration
PORT=3000
NODE_ENV=development

# Optional AI Providers (System automatically falls back to Smart Rule-Based NLP if empty)
# Get a Google Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Get an OpenAI API Key from: https://platform.openai.com/
OPENAI_API_KEY=

# Demo Authentication vs Production
DEMO_AUTH_ENABLED=true
